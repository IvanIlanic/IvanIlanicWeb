# Optional build override; the default public origin is https://ivanilanic.com.
# Used for canonical URLs and sitemap. No variable is required for this domain.
# SITE_URL=https://ivanilanic.com

# Optional: the verification CONTENT value from Google Search Console's HTML tag.
# This value is public metadata, not a Google account password or API key.
# GOOGLE_SITE_VERIFICATION=your-verification-value
